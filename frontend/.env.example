# AromaPOS Frontend Environment Variables
# In local development, leave BACKEND_URL empty or http://localhost:8080 (handled by next.config.mjs rewrites)
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# In production (Render):
# BACKEND_URL=https://aromapos-backend.onrender.com
# NEXT_PUBLIC_API_URL=https://aromapos-backend.onrender.com

# Google OAuth 2.0 Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

