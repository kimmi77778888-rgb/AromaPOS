{
  "name": "aromapos-system",
  "version": "2.0.0",
  "description": "AromaPOS - Artisan Coffee E-Commerce & Point-of-Sale System",
  "scripts": {
    "start": "cmd /c start-all.bat",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd demo && mvnw.cmd spring-boot:run",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "cd demo && mvnw.cmd clean package -DskipTests"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "pos",
    "coffee",
    "ecommerce",
    "spring-boot",
    "nextjs",
    "khqr",
    "bakong"
  ],
  "author": "AromaPOS Team",
  "license": "MIT"
}

